    ex:question_malay "apakah cara mencegah nyamuk daripada membiak" ;
    ex:source "https://www.doctoroncall.com.my/health-centre/denggi/demam-denggi/cara-mencegah-denggi" .

<http://example.org/dengue/qa142> a ex:QA_Pair ;
    ex:answer_english """~ Make sure there are no mosquito breeding grounds.
~ Use insect spray to kill mosquitoes.
