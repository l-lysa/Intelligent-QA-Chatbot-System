    ex:source "https://health.insuresavvy.com.my/ms_MY/dengue-fever/" .

<http://example.org/dengue/qa115> a ex:QA_Pair ;
    ex:answer_english "Destroy the breeding grounds of mosquitoes, protect yourself from mosquito bites and reduce visiting or activity in high -risk areas of dengue." ;
    ex:answer_malay "Memusnahkan tempat pembiakan nyamuk, melindungi diri daripada gigitan nyamuk dan kurangkan melawat atau beraktiviti di kawasan berisiko tinggi denggi." ;
